<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ECommerce.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides IdentityUser<TKey> / IdentityRole<TKey> without pulling in the full ASP.NET Core web SDK.
         Domain intentionally references this single framework-adjacent type so ApplicationUser/ApplicationRole
         can live alongside the rest of the entities; everything else in Domain stays framework-agnostic. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.0" />
  </ItemGroup>

</Project>
